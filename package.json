{
  "name": "kian-khatibi-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run lint:css && npm run test && npm run format:check",
    "lint:css": "stylelint \"**/*.css\""
  },
  "dependencies": {
    "next": "15.5.24",
    "ogl": "^1.0.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.20.4",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.24",
    "postcss": "8.5.23",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.3.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "postcss": "8.5.23"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
